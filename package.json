{
  "name": "kbl-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "qs": "6.16.2"
  },
  "imports": {
    "#domain": "./shared_kernel/domain/index.js",
    "#shared/*": "./shared_kernel/*",
    "#lib/*": "./server/lib/*",
    "#infra/*": "./server/infrastructure/*",
    "#routes/*": "./server/routes/*",
    "#use-cases/*": "./server/application/use-cases/*",
    "#dto/*": "./server/application/dto/*"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run build && cross-env NODE_ENV=production node server/index.js",
    "test": "npm run test:unit && npm run test:contract",
    "test:unit": "vitest run",
    "test:contract": "node --test server/test-contract.mjs server/test-acceptance.mjs server/test-fase6.mjs server/lib/test-active-recall-store.mjs server/infrastructure/test-observabilidad.mjs",
    "test:watch": "vitest",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "chokidar": "^6.0.0",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "puppeteer-core": "^25.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.2",
    "sql.js": "^1.11.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.5.2",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.15",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
