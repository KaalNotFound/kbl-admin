# KBL Admin — Environment Variables
# Copy to .env and customize

# Server
PORT=3002
HOST=127.0.0.1
NODE_ENV=development

# Security (optional — leave blank to disable API key auth)
API_KEY=

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# External services
ANKI_URL=http://localhost:8765
CDP_URL=http://127.0.0.1:9222
NOTEBOOKLM_URL=http://localhost:3000

# Persistence (optional — defaults live in server/data/, gitignored)
# KBL_DATA_DIR overrides the default directory for JSON stores.
# MASTERY_STORE_PATH / ACTIVE_RECALL_STORE_PATH override individual store files.

# Obsidian vault integration (optional — vault-dependent dashboards degrade
# gracefully to empty/warn state when this folder is missing or unreadable)
# KBL_VAULT_ROOT=/path/to/your/obsidian/vault
